# ─── Email delivery ────────────────────────────────────────────────
# Two providers are supported. SMTP wins whenever SMTP_HOST + SMTP_USER
# are set; otherwise the app falls back to Resend.
#
# Option A — SMTP (cPanel / Hostinger / Gmail / Office365):
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=info@yourdomain.com
#   SMTP_PASS=your-mailbox-password-or-app-password
#
# Option B — Resend (https://resend.com/api-keys):
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#   (the from-domain must be verified at https://resend.com/domains)

# Option A — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Set true ONLY for hosts with a self-signed certificate (dev/staging).
SMTP_ALLOW_SELF_SIGNED=false

# Option B — Resend (used when SMTP is not configured)
RESEND_API_KEY=

# Contact email / admin notifications
EMAIL_FROM=tahasil@aiolos.cloud
EMAIL_TO=tahasil@aiolos.cloud

