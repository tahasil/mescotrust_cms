# ─── Email delivery ────────────────────────────────────────────────
# Two providers are supported. SMTP wins whenever SMTP_HOST + SMTP_USER
# are set; otherwise the app falls back to Resend.

# Option A — Resend (https://resend.com/api-keys):
#   (the from-domain must be verified at https://resend.com/domains)
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx (used when SMTP is not configured)

# Option B — SMTP (Amazon SES / cPanel / Hostinger / Gmail / Office365):
#   Port 465 => implicit TLS (secure), 587 => STARTTLS. Both supported.
#   SMTP_HOST must match the region of the SES account (ap-south-1 here).

SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=465
SMTP_USER=AKIAUJUCL5IJOYIEZCIT
SMTP_PASS=BHHBgZcQLLRIdIjy9yGwFzIFSD8RP8rVoUaaGNiwqZpJ

# Set true ONLY for hosts with a self-signed certificate (dev/staging).
# Leave unset for Amazon SES, which presents a valid cert.


# Sender address used by the app for all outgoing mail. Must be a verified SES
# identity (or Resend domain), otherwise every send fails.
SMTP_FROM=no-reply@aioloslabs.com

# "From" address used as a fallback when SMTP_FROM is not set.
EMAIL_FROM=tahasil@aiolos.cloud
# Admin copy recipient for notifications (donation received, contact form, ...).
EMAIL_TO=tahasil@aiolos.cloud

