# MongoDB connection string (default: local MongoDB)
MONGODB_URI=mongodb://localhost:27017/mescotrust

# NextAuth – required for login (dev fallback; use a real secret in production)
NEXTAUTH_SECRET=mescotrust-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Optional: first admin user (for npm run seed)
# ADMIN_EMAIL=admin@mescotrust.org
# ADMIN_PASSWORD=Admin@123
