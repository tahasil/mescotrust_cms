# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# ─── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Public site URL (used for canonical tags, sitemap, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email delivery ──────────────────────────────────────────────────────────
# Two providers are supported. SMTP wins whenever SMTP_HOST + SMTP_USER are set;
# otherwise the app falls back to Resend.

# Option A — Resend (https://resend.com/api-keys). The from-domain must be
# verified at https://resend.com/domains
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Option B — SMTP (Amazon SES / cPanel / Hostinger / Gmail / Office365).
# Amazon SES example (region must match your SES region):
#   host     email-smtp.<region>.amazonaws.com
#   username = SES "SMTP credentials" username (NOT your AWS access key id)
#   password = SES "SMTP credentials" password
#   port     465 (implicit TLS) or 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Only set for hosts with a self-signed certificate (dev/staging only).
# SMTP_ALLOW_SELF_SIGNED=true

# "From" address for every outgoing mail. Its domain MUST be verified with the
# active provider (SES identity / Resend domain) or sending will fail.
# NOTE: SMTP_FROM is intentionally not read by the app — EMAIL_FROM is the
# single source of truth for the sender address.
EMAIL_FROM=
# Admin copy recipient for notifications (e.g. donation received alerts).
EMAIL_TO=

# ─── Payment gateway ─────────────────────────────────────────────────────────
# Active payment gateway: ccavenue | razorpay
PAYMENT_GATEWAY=razorpay

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CCAvenue
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_GATEWAY_URL=https://test.ccavenue.com/transaction/transaction.do

# ─── Seed / admin bootstrap ──────────────────────────────────────────────────
# ADMIN_EMAIL=
# ADMIN_PASSWORD=