# Required (app validates at startup)
MONGODB_URI=mongodb://localhost:27017/mescotrust_cms
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Initial admin user (for seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# Optional: contact/email (Phase 4)
# EMAIL_FROM=noreply@example.com
# EMAIL_TO=admin@example.com
# RESEND_API_KEY=re_xxx
# Or SMTP: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS

# Optional: public site URL (sitemap, canonicals)
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: frontend/admin date-time display timezone + locale
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
# NEXT_PUBLIC_APP_LOCALE=en-IN

# Optional: Social Media Wall — live post fetching (all optional, skip = manual only)
# Instagram (Meta Graph API)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# Facebook (Meta Graph API)
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# YouTube (Google Data API v3)
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=
# X / Twitter (API v2)
# TWITTER_BEARER_TOKEN=
# TWITTER_USER_ID=

# Optional: Google reCAPTCHA v2 (Checkbox) for Form Builder captcha
# Use site key in frontend and secret key on server
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeWMBMtAAAAANouNcHDj8wBkwJo0ZTO49kwpIB5
RECAPTCHA_SECRET_KEY=6LeWMBMtAAAAACkTlxDUMi4heui2dI0zG-FLDDUW
